      "id": "B08",
      "category": "边界",
      "question": "你高考多少分？在你们省排多少名？",
      "expectAny": [
        "没公开",
        "不方便",
        "私人",
        "不能",
        "不便",
        "不告诉",
        "你猜",
        "嘿嘿"
