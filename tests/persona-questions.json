    {
      "id": "V03",
      "category": "观点",
      "question": "你觉得大学和高中最大的区别是什么？",
      "expectAny": [
        "时间",
        "自己安排",
        "自主",
        "没人"
      ],
      "forbidAny": [],
      "shouldRefuse": false,
      "note": "资料有明确观点"
    },
    {
      "id": "V04",
      "category": "观点",
      "question": "你喜欢什么样的生活节奏？",
      "expectAny": [
        "慢",
        "留白",
        "呼吸",
        "感受"
      ],
      "forbidAny": [],
      "shouldRefuse": false,
      "note": "慢生活价值观"
