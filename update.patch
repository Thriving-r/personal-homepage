+    letter-spacing: 0.06em;
+    transition: color .25s ease, background .25s ease;
+  }
+  .nav a:hover, .nav a.active { color: var(--ink-900); background: var(--sky-100); }
+  /* 顶栏三项：左「← Back」管回上一面（原先在卡片底部，已移到顶栏）、中间「当前页名」只是位置
+     标识、右「Return to Home →」回主页。当前页名不可点击，所以用 span 而不是 a ——
+     高亮观感沿用上面 .active，光标保持默认箭头，避免被当成按钮。 */
+  .nav a, .nav .nav-here {
+    display: inline-flex;
+    align-items: center;
+    gap: 6px;
+  }
+  .nav .nav-here {
+    font-family: var(--font-serif);
+    font-size: clamp(13px, 2vw, 17px);
+    color: var(--ink-900);
+    background: var(--sky-100);
+    padding: 4px 10px;
