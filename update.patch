--- a/bci.html
+++ b/bci.html
@@ -163,6 +163,46 @@
     background: rgba(95, 190, 255, 0.16);
     box-shadow: inset 0 0 0 1px rgba(95, 190, 255, 0.28);
   }
+  /* 顶栏三项：左「← Back」管回上一面、中间「当前页名」只是位置标识、右「Return to Home →」回主页。
+     当前页名不可点击，所以用 span 而不是 a —— 高亮观感沿用上面 .active 的青色胶囊
+     （本页是暗色科技风，不能照搬主页子页的 sky-100 浅底），光标保持默认箭头，避免被当成按钮。 */
+  .nav a, .nav .nav-here {
+    display: inline-flex;
+    align-items: center;
+    gap: 6px;
+  }
+  .nav .nav-here {
+    font-size: clamp(12px, 1.7vw, 14px);
+    font-family: var(--font-sans);
+    color: #eaf5ff;
+    background: rgba(95, 190, 255, 0.16);
+    padding: 5px 12px;
+    border-radius: 999px;
+    letter-spacing: 0.05em;
+    white-space: nowrap;
+    box-shadow: inset 0 0 0 1px rgba(95, 190, 255, 0.28);
+    cursor: default;
+  }
+  .nav-arrow {
+    width: 14px;
+    height: 14px;
+    flex: none;
+    fill: none;
