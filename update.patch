+  /* 顶栏从两项变三项（多一枚「Return to Home →」），手机上要把留白收回来，否则会顶出胶囊。
+     这一档只收紧 gap / 内边距 / 字距，字号仍是上面 clamp 的原值。 */
+  @media (max-width: 560px) {
+    .nav { gap: min(10px, 1.6vw); padding-left: 10px; padding-right: 10px; }
+    .nav a, .nav .nav-here { padding-left: 7px; padding-right: 7px; letter-spacing: 0.02em; }
